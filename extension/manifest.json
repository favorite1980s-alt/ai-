{
  "manifest_version": 3,
  "name": "Movie English Study — 오프라인 영어 자막",
  "version": "0.4.0",
  "description": "Whisper 로컬 실시간 영어 자막, 단어 클릭 영한 사전 및 단어장 (유료 API 없음)",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Movie English Study",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "116"
}